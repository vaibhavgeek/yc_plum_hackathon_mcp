# Paste your OpenAI API key here (rotate the one that was shared in chat!)
OPENAI_API_KEY=your-new-rotated-key-here

# Anthropic API key for Claude Agent SDK (used for visualize_diagnosis)
ANTHROPIC_API_KEY=your-anthropic-api-key

# --- OR use AWS Bedrock instead of the Anthropic API ---
# Set CLAUDE_CODE_USE_BEDROCK=1 to route through Bedrock.
CLAUDE_CODE_USE_BEDROCK=1
AWS_ACCESS_KEY_ID=your-aws-key
AWS_SECRET_ACCESS_KEY=your-aws-secret
AWS_REGION=ap-south-1
ANTHROPIC_MODEL=global.anthropic.claude-opus-4-6-v1

# MCP server URL
MCP_SERVER_URL=http://127.0.0.1:8000/mcp

# Web UI port
WEB_PORT=5173

# Medplum credentials (rotate any secret ever pasted in chat!)
MEDPLUM_BASE_URL=https://api.medplum.com
MEDPLUM_CLIENT_ID=your-medplum-client-id
MEDPLUM_CLIENT_SECRET=your-medplum-client-secret

# Stedi healthcare API key for eligibility checks (https://www.stedi.com/docs/healthcare)
STEDI_API_KEY=test_...
