# MCP server: FastMCP over Streamable-HTTP
FROM python:3.12-slim

WORKDIR /app

# System deps for httpx / SSL
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
  && rm -rf /var/lib/apt/lists/*

# Use uv for fast, deterministic Python installs
RUN pip install --no-cache-dir uv

# Copy project metadata first for better layer caching
COPY pyproject.toml README.md ./

# Copy the server package (main + medplum + conversation_log + static assets)
COPY server ./server

# Install project deps + the server package itself
RUN uv pip install --system --no-cache .

# Cloud Run sets PORT; app binds 0.0.0.0 in this container
ENV HOST=0.0.0.0 \
    PORT=8000

EXPOSE 8000

CMD ["python", "-m", "server.main"]
